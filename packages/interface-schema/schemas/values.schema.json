{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-platform.local/v1/values.schema.json",
  "title": "ValuesData",
  "description": "Topic values: Prozesswerte, zyklisch oder bei Änderung",
  "type": "object",
  "required": ["values"],
  "properties": {
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "value": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
