{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-platform.local/v1/counters.schema.json",
  "title": "CountersData",
  "description": "Topic counters (retained): kumulativ seit resetAt, zyklisch (Vorschlag 5 s). Stufe basic liefert gut und gesamt, ab standard auch schlecht.",
  "type": "object",
  "required": ["good", "total", "resetAt"],
  "properties": {
    "good": { "type": "integer", "minimum": 0 },
    "bad": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "resetAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  },
  "additionalProperties": false
}
