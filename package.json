{
  "name": "iot-platform",
  "private": true,
  "description": "Modulare IoT-Plattform für Pharma-Abfülllinien auf Siemens Industrial Edge",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tooling/scripts/dev.mjs",
    "dev:broker": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "dev:broker:stop": "docker compose -f deploy/docker-compose.dev.yml down",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "pnpm --filter @iot/docs dev",
    "docs:build": "pnpm --filter @iot/docs build",
    "prepare": "lefthook install",
    "lint:css": "stylelint \"**/*.css\"",
    "storybook": "pnpm --filter @iot/ui storybook",
    "storybook:build": "pnpm --filter @iot/ui storybook:build",
    "create-module": "node tooling/scripts/create-module.mjs",
    "dev:mosquitto": "IOT_BROKER=mosquitto node tooling/scripts/dev.mjs",
    "sim": "pnpm --silent --filter @iot/simulator control"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "aedes": "1.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
